{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user settings and business profile info",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "defaultStatus": { "type": "string", "enum": ["PAID", "UNPAID"] },
        "materials": { "type": "array" },
        "pdfFooterNote": { "type": "string" },
        "showSqFtInPdf": { "type": "boolean" },
        "showMaterialInPdf": { "type": "boolean" },
        "pdfThemeColor": { "type": "string" },
        "pdfAccentColor": { "type": "string" },
        "minSqFtPerPiece": { "type": "number" },
        "minItemAmount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "logoUrl": { "type": "string" }
      },
      "required": ["businessName"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Stores a sales estimate invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["SALE"] },
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string" },
        "partyName": { "type": "string" },
        "billingAddress": { "type": "string" },
        "items": { "type": "array" },
        "subTotal": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string", "enum": ["PAID", "UNPAID"] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "attachments": { "type": "array" }
      },
      "required": ["id", "invoiceNumber", "date", "partyName", "items", "grandTotal", "status", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}/profile/settings": {
      "schema": "UserProfile",
      "description": "Stores a user's business profile preferences"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Stores individual sales transaction documents belonging to the user"
    }
  }
}
